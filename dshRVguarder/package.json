{
  "name": "dsh-rvguarder",
  "version": "0.2.0-rc.6",
  "private": true,
  "type": "module",
  "description": "DSH 0.2.1-rc.2 / rc.3 的 RVguarder 适配插件：核心守卫 + 宿主内嵌管理界面",
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json && node scripts/verify-client-shape.mjs",
    "build": "tsc",
    "build:client": "node scripts/build-client.mjs",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "prepack": "npm run build && node scripts/build-client.mjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    },
    "./client": {
      "default": "./dist/webclient.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./semantic-tools-deny": {
      "types": "./dist/semantic-tools-deny.d.ts",
      "default": "./dist/semantic-tools-deny.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "dist",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0",
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.0",
    "esbuild": "0.25.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-working-directory": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent-spawn-in-process": {
      "optional": true
    }
  }
}
