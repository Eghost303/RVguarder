{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "react": ["client-deps/@types/react/index.d.ts"],
      "zod": ["client-deps/zod/index.d.ts"]
    },
    "types": []
  },
  "include": [
    "client/**/*.ts"
  ]
}
